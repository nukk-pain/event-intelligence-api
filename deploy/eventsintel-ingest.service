[Unit]
Description=eventsintel ingest batch (COEX/KINTEX crawl + normalize + diff)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eventsintel
Group=eventsintel
StateDirectory=eventsintel
StateDirectoryMode=0750
WorkingDirectory=/srv/developer/events-intel
ExecStart=/srv/developer/events-intel/eventsintel ingest
Environment=EVENTSINTEL_DB_PATH=/srv/developer/events-intel/data/events.db
Environment=EVENTSINTEL_LOCK_PATH=/srv/developer/events-intel/data/ingest.lock
Environment=EVENTSINTEL_RATE_PER_MIN=30
Environment=EVENTSINTEL_SOURCE_CONCURRENCY=2
Environment=EVENTSINTEL_DETAIL_WORKERS=4
# 20m was inherited from the crawl-only era and had no rationale on record.
# The rule the code states is "comfortably below CrawlInterval", and the timer
# runs every 24h, so 20m was self-imposed: it forced the render budget down
# rather than the other way round. 2h keeps every protection (a runaway batch
# still exits and releases the flock, truncation still stays graceful and
# still refuses to poison a cut-short source's discovery baseline) while
# leaving room to render the pages that actually need it.
Environment=EVENTSINTEL_INGEST_DEADLINE=2h
# Renders per batch. The eligible pool (upcoming, deadline-less, within 120
# days) is ~52 shells per run; 55 covers it without relying on the 4-day
# rotation to catch the remainder.
Environment=EVENTSINTEL_RENDER_MAX_PAGES=55
Environment=HOME=/var/lib/eventsintel
# Solar enrichment credentials and switches live in a root-only env file on the
# host, never in this unit or the repo. Absent file = enrichment off, which is
# also the rollback: remove the file and restart nothing.
EnvironmentFile=-/srv/developer/events-intel/solar.env
# Cloudflare purge credentials, same host-only pattern. This reference was
# silently lost once when the unit was overwritten from the repo copy, which is
# why both env files are now recorded here rather than only on the host.
EnvironmentFile=-/srv/developer/events-intel/cf-purge.env
# The binary also takes a flock single-flight lock; the timer + lock together
# guarantee no overlapping ingest runs.
