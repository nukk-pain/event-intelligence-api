# eventsintel runtime config template.
# Copy to a private location and export before running. Do NOT commit real values.
# Runtime reads EVENTSINTEL_* env vars (config.FromEnv); there is no config file.

# --- Core (see internal/config/config.go for full list + defaults) ---
# EVENTSINTEL_HTTP_ADDR=:8080
# EVENTSINTEL_DB_PATH=eventsintel.db
# EVENTSINTEL_USER_AGENT="eventsintel/1.0 (+https://events.nukk.net)"

# --- Cloudflare cache purge (ingest unit only; optional) ---
# EVENTSINTEL_CF_PURGE_ZONE=
# EVENTSINTEL_CF_PURGE_TOKEN=        # secret

# --- Solar agent (feat/solar-agent; ingest-time only, never on read path) ---
# Upstage Solar is OpenAI-compatible. Get a key at https://console.upstage.ai
# EVENTSINTEL_SOLAR_API_KEY=         # secret — do NOT commit
# EVENTSINTEL_SOLAR_BASE_URL=https://api.upstage.ai/v1
# EVENTSINTEL_SOLAR_MODEL=solar-open2

# --- Tavily web search (eventscout live-search mode; optional) ---
# Create a key at https://app.tavily.com and keep the real value only in an
# ignored local .env file or the process environment. Never commit or log it.
# EVENTSINTEL_TAVILY_API_KEY=        # secret — do NOT commit

# --- Local A/B model (optional; compare Korean extraction vs Solar) ---
# EVENTSINTEL_LOCAL_BASE_URL=http://127.0.0.1:18900/v1
# EVENTSINTEL_LOCAL_MODEL=qwen36-dwq
